// skrini.swa -- skrini zote, droo ya pembeni, mguso, uhuishaji, wasifu na rekodi.
//
// Mtiririko: Kajara Studio -> karibu (lugha) -> wasifu (mara ya kwanza) ->
// nyumbani -> mpangilio / sheria / chumba cha Wi-Fi -> mchezo -> mshindi.
// Muundo: upau unaoelea juu (droo, kichwa, kipaza sauti), droo inayoteleza
// kutoka kushoto, vibao vya majina kwenye pembe ya kila mchezaji, kete
// zinazoguswa kurusha, ujumbe unaoelea juu ya ubao, na karatasi ya mshindi
// inayopanda kutoka chini. Fremu huombwa tu wakati kitu kinasonga.

n64 sasa_nano();
w0 omba_fremu_ijayo();
w0 omba_tiki();
w0 mtandao_tuma_hali();
w0 mtandao_ombi(n32 aina, n32 a, n32 b);
n32 mtandao_ni_mteja();
n32 mtandao_ni_mwenyeji();
w0 mtandao_funga();
w0 mtandao_anza_mwenyeji();
w0 mtandao_anza_kutafuta();
w0 mtandao_jiunge(n32 chumba);
w0 mtandao_dai_kiti(n32 kiti);
w0 mtandao_kila_fremu();
n32 mtandao_vyumba_idadi();
n8* mtandao_jina_la_chumba(n32 i);
n8* mtandao_anwani_ya_chumba(n32 i);
n8* mtandao_anwani_yangu();
n32 mtandao_inaunganisha();
n32 mtandao_kosa_la_kujiunga();
n32 kiti_changu();
n8* jina_la_kiti(n32 m);
n32 mmiliki_wa_kiti(n32 m);
n8 nambari_ya_chumba[8];
n32 sauti_kipaza_kiko_wazi();
w0 sauti_badili_kipaza();
n32 sauti_anaongea(n32 kiti);

n32 sasa_ms() { rudisha sasa_nano() / 1000000; }

// fonti: 0 kawaida, 1 wastani, 2 nzito
n32 F_KAWAIDA = 0;
n32 F_WASTANI = 1;
n32 F_NZITO = 2;
n32 F_SERIF = 3;        // vichwa: Source Serif 4

// ---------------------------------------------------------------- mandhari
n32 R_MANDHARI = 0;
n32 R_KADI = 0;
n32 R_KADI_JUU = 0;
n32 R_MAANDISHI = 0;
n32 R_HAFIFU = 0;
n32 R_DHAHABU = 0;
n32 R_MSTARI = 0;
n32 R_KIDOLE = 0;      // kidole cha kidhibiti cha sehemu
n32 R_NJIA_YA_KIDOLE = 0;
n32 R_DROO = 0;
n32 R_DUARA = 0;       // duara la aikoni
n32 R_KISHIKIO = 0;    // kishikio cha karatasi
n32 R_SWICHI = 0;      // swichi iliyozimwa
n32 R_DOKEZO = 0;      // maandishi ya dokezo
n32 R_IKONI = 0;
n32 R_KITUFE = 0;      // kitufe kikuu: cheupe gizani, cheusi mwangani
n32 R_KITUFE_M = 0;
n32 PALETI[8];
n32 rangi_ya_kiti[4];

w0 andaa_mandhari(n32 giza) {
    kama (giza) {
        R_MANDHARI = rgb(21, 21, 21);
        R_DROO = rgb(17, 17, 17);
        R_KADI = rgb(32, 32, 31);
        R_KADI_JUU = rgb(49, 49, 49);
        R_DUARA = rgb(55, 55, 54);
        R_MSTARI = rgb(61, 60, 58);
        R_KISHIKIO = rgb(52, 51, 50);
        R_SWICHI = rgb(77, 77, 76);
        R_NJIA_YA_KIDOLE = rgb(32, 32, 31);
        R_KIDOLE = rgb(61, 60, 58);
        R_MAANDISHI = rgb(240, 239, 236);
        R_HAFIFU = rgb(195, 194, 183);
        R_DOKEZO = rgb(151, 149, 141);
        R_IKONI = rgb(195, 194, 183);
        R_KITUFE = rgb(255, 255, 255);
        R_KITUFE_M = rgb(11, 11, 11);
        RANGI_YA_UBAO = rgb(32, 32, 31);
        RANGI_YA_SELI = rgb(49, 49, 49);
        RANGI_YA_NAMBA = rgb(140, 139, 133);
        RANGI_YA_SALAMA = rgb(66, 66, 64);
        RANGI_YA_KETE = rgb(240, 239, 236);
        RANGI_YA_KETE_UKINGO = rgb(240, 239, 236);
        RANGI_YA_KETE_ZIMA = rgb(120, 119, 115);
        RANGI_YA_NUKTA = rgb(21, 21, 21);
        RANGI_YA_UKINGO_WA_PAUNI = rgb(240, 239, 236);
    } sivyo {
        R_MANDHARI = rgb(249, 249, 247);
        R_DROO = rgb(249, 249, 247);
        R_KADI = rgb(255, 255, 255);
        R_KADI_JUU = rgb(240, 239, 236);
        R_DUARA = rgb(230, 230, 230);
        R_MSTARI = rgb(220, 220, 220);
        R_KISHIKIO = rgb(216, 216, 214);
        R_SWICHI = rgb(210, 210, 207);
        R_NJIA_YA_KIDOLE = rgb(240, 239, 236);
        R_KIDOLE = rgb(255, 255, 255);
        R_MAANDISHI = rgb(11, 11, 11);
        R_HAFIFU = rgb(82, 81, 78);
        R_DOKEZO = rgb(123, 121, 116);
        R_IKONI = rgb(56, 56, 53);
        R_KITUFE = rgb(11, 11, 11);
        R_KITUFE_M = rgb(255, 255, 255);
        RANGI_YA_UBAO = rgb(255, 255, 255);
        RANGI_YA_SELI = rgb(240, 239, 236);
        RANGI_YA_NAMBA = rgb(138, 136, 130);
        RANGI_YA_SALAMA = rgb(222, 221, 216);
        RANGI_YA_KETE = rgb(255, 255, 255);
        RANGI_YA_KETE_UKINGO = rgb(220, 220, 220);
        RANGI_YA_KETE_ZIMA = rgb(236, 235, 231);
        RANGI_YA_NUKTA = rgb(11, 11, 11);
        RANGI_YA_UKINGO_WA_PAUNI = rgb(255, 255, 255);
    }
    R_DHAHABU = rgb(217, 119, 87);
    PALETI[0] = rgb(204, 98, 80);
    PALETI[1] = rgb(88, 150, 110);
    PALETI[2] = rgb(214, 168, 72);
    PALETI[3] = rgb(84, 124, 196);
    PALETI[4] = rgb(146, 108, 196);
    PALETI[5] = rgb(217, 119, 87);
    PALETI[6] = rgb(66, 150, 150);
    PALETI[7] = rgb(204, 112, 150);
}

w0 andaa_rangi_za_viti() {
    rangi_ya_kiti[0] = 0; rangi_ya_kiti[1] = 1; rangi_ya_kiti[2] = 2; rangi_ya_kiti[3] = 3;
}

n32 rangi_ya_mchezaji(n32 m) { rudisha PALETI[rangi_ya_kiti[m]]; }

// mandhari: mteremko mwororo wa wima
w0 chora_mandhari() {
    mstatili(0, 0, upana_wa_skrini, urefu_wa_skrini, R_MANDHARI);
}

