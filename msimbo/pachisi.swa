husisha { maktaba/kumbukumbu.swa }
husisha { maktaba/mfuatano.swa }
husisha { msimbo/mantiki.swa }
husisha { msimbo/michoro.swa }
husisha { msimbo/fonti.swa }
husisha { msimbo/ubao.swa }
husisha { msimbo/skrini.swa }
husisha { msimbo/mtandao.swa }
husisha { msimbo/sauti.swa }
husisha { msimbo/sasisho.swa }

// pachisi.swa -- Pachisi kwa Android, imeandikwa kwa Swa (Kajara Studio).
//
// NativeActivity hupakia maktaba hii (bin/swa --arm64-maktaba) na kuita
// `anza`. Faili hili ni gundi ya Android tu: vitendo vya dirisha, foleni ya
// mguso, mzunguko wa fremu (Choreographer) unaoendesha uhuishaji, kompyuta na
// mtandao. Kanuni: mantiki.swa; mchoro: michoro.swa, fonti.swa, ubao.swa;
// skrini na mguso: skrini.swa; vyumba vya Wi-Fi: mtandao.swa; sauti: sauti.swa; sasisho
// kutoka kwa mwenyeji: sasisho.swa.

nje "libandroid.so" {
    n32 dirisha_weka_umbo(n8* dirisha, n32 upana, n32 urefu, n32 umbo) = "ANativeWindow_setBuffersGeometry";
    n32 dirisha_funga(n8* dirisha, n8* chombo, n8* mipaka) = "ANativeWindow_lock";
    n32 dirisha_onyesha(n8* dirisha) = "ANativeWindow_unlockAndPost";
    n8* kitanzi_cha_uzi() = "ALooper_forThread";
    w0 foleni_unganisha(n8* foleni, n8* kitanzi, n32 kitambulisho, n8* kazi, n8* data) = "AInputQueue_attachLooper";
    w0 foleni_tenganisha(n8* foleni) = "AInputQueue_detachLooper";
    n32 foleni_chukua(n8* foleni, n8** tukio) = "AInputQueue_getEvent";
    n32 foleni_kabla(n8* foleni, n8* tukio) = "AInputQueue_preDispatchEvent";
    w0 foleni_maliza(n8* foleni, n8* tukio, n32 limeshughulikiwa) = "AInputQueue_finishEvent";
    n32 tukio_aina(n8* tukio) = "AInputEvent_getType";
    n32 mguso_kitendo(n8* tukio) = "AMotionEvent_getAction";
    d32 mguso_x(n8* tukio, n64 kidole) = "AMotionEvent_getX";
    d32 mguso_y(n8* tukio, n64 kidole) = "AMotionEvent_getY";
    n32 ufunguo_namba(n8* tukio) = "AKeyEvent_getKeyCode";
    n32 ufunguo_kitendo(n8* tukio) = "AKeyEvent_getAction";
    n8* mpangaji_wa_fremu() = "AChoreographer_getInstance";
    w0 omba_fremu(n8* mpangaji, n8* kazi, n8* data) = "AChoreographer_postFrameCallback64";
    n8* rasilimali_fungua(n8* meneja, n8* jina, n32 namna) = "AAssetManager_open";
    n8* rasilimali_data(n8* rasilimali) = "AAsset_getBuffer";
}

nje "liblog.so" {
    n32 kumbukumbu(n32 kipaumbele, n8* lebo, n8* ujumbe) = "__android_log_write";
}

// ---------------------------------------------------------------- nasibu
n8 chombo_cha_nasibu[1];
n32 kete_nasibu() {
    // getrandom; baiti >= 252 hukataliwa ili kila uso uwe na nafasi sawa
    wakati (1) {
        wito_wa_mfumo(318, chombo_cha_nasibu, 1, 0, 0, 0, 0);
        n32 b = chombo_cha_nasibu[0] & 255;
        kama (b < 252) { rudisha b % 6 + 1; }
    }
    rudisha 1;
}

n64 sasa_nano() {
    n64 ts[2];
    wito_wa_mfumo(228, 1, ts, 0, 0, 0, 0);         // clock_gettime(CLOCK_MONOTONIC)
    rudisha ts[0] * 1000000000 + ts[1];
}

// ---------------------------------------------------------------- mchoro
n8* dirisha_hili = 0;
n8* foleni_hii = 0;
n8 chombo_cha_dirisha[48];

w0 chora() {
    kama (dirisha_hili == 0) { rudisha; }
    dirisha_weka_umbo(dirisha_hili, 0, 0, 1);          // WINDOW_FORMAT_RGBA_8888
    kama (dirisha_funga(dirisha_hili, chombo_cha_dirisha, 0) != 0) { rudisha; }
    n32* vipimo = chombo_cha_dirisha;
    kama (vipimo[0] != upana_wa_skrini || vipimo[1] != urefu_wa_skrini) { akiba_halali = 0; }
    upana_wa_skrini = vipimo[0];
    urefu_wa_skrini = vipimo[1];
    hatua_ya_mstari = vipimo[2];
    n8** anwani = chombo_cha_dirisha;       // ANativeWindow_Buffer.bits: baiti 16
    n8* baiti_za_pikseli = anwani[2];
    pikseli = baiti_za_pikseli;
    chora_skrini();
    dirisha_onyesha(dirisha_hili);
}

// ---------------------------------------------------------------- mzunguko wa fremu
// Fremu ina kazi mbili: tiki (mtandao, sauti, kompyuta) na kuchora. Kuchora
// skrini nzima hufanyika tu kitu kinapobadilika (omba_fremu_ijayo); tiki pekee
// (omba_tiki) haichori -- vyumba vya Wi-Fi na pumziko la kompyuta havichori
// skrini mara 60 kwa sekunde bila sababu, na mguso hujibiwa haraka.
n32 fremu_imeombwa = 0;
n32 chora_inahitajika = 0;
n32 kompyuta_wakati = 0;          // ms ambapo kompyuta itafanya hatua inayofuata
n32 KOMPYUTA_PUMZIKO_MS = 520;

w0 fremu(n64 wakati_wa_fremu, n8* data);

w0 omba_tiki() {
    kama (fremu_imeombwa) { rudisha; }
    fremu_imeombwa = 1;
    omba_fremu(mpangaji_wa_fremu(), &fremu, 0);
}

w0 omba_fremu_ijayo() { chora_inahitajika = 1; omba_tiki(); }

w0 kompyuta_hatua() {
    kama (hali_ya_zamu == HALI_RUSHA) { fanya_rusha(); rudisha; }
    kama (hali_ya_zamu == HALI_SOGEZA) {
        chagua_hatua_ya_kompyuta();
        kama (pauni_bora < 0) { idadi_ya_hatua = 0; maliza_zamu(); mtandao_tuma_hali(); rudisha; }
        fanya_hatua(pauni_bora, hatua_bora);
    }
}

// zamu ni ya kompyuta inayoendeshwa na simu hii
n32 iko_nyuma = 0;
n32 zamu_ya_kompyuta() {
    kama (iko_nyuma) { rudisha 0; }
    kama (skrini != S_MCHEZO || droo_iko_wazi || mshindi >= 0 || mtandao_ni_mteja()) { rudisha 0; }
    // chumba: mwenyeji pekee huendesha kompyuta, na si wakati kimesimamishwa
    // (mteja anayeunganisha upya hana jukumu la mteja kwa muda)
    kama (aina_ya_mchezo == HALI_YA_MCHEZO_WIFI && (mtandao_ni_mwenyeji() == 0 || mtandao_kimesimamishwa())) { rudisha 0; }
    rudisha ni_kompyuta[zamu];
}

// kompyuta inacheza ikiwa ni zamu yake na hakuna uhuishaji
w0 endesha_kompyuta() {
    kama (zamu_ya_kompyuta() == 0) { rudisha; }
    kama (uhuishaji != U_HAKUNA) { kompyuta_wakati = 0; rudisha; }
    n32 sasa = sasa_ms();
    kama (kompyuta_wakati == 0) { kompyuta_wakati = sasa + KOMPYUTA_PUMZIKO_MS; }
    kama (sasa >= kompyuta_wakati) { kompyuta_wakati = 0; kompyuta_hatua(); }
    omba_tiki();
}

w0 fremu(n64 wakati_wa_fremu, n8* data) {
    fremu_imeombwa = 0;
    mtandao_kila_fremu();
    sauti_kila_fremu();
    sasisho_kila_fremu();
    endesha_kompyuta();
    kama (chora_inahitajika) { chora_inahitajika = 0; chora(); }
    // uhuishaji ukiisha kwenye fremu hii, tiki zinaendelea ili kompyuta icheze
    kama (zamu_ya_kompyuta()) { omba_tiki(); }
}

// ---------------------------------------------------------------- mguso
n32 mguso(n32 kishikio, n32 matukio, n8* data) {
    n8* tukio = 0;
    wakati (foleni_hii != 0 && foleni_chukua(foleni_hii, &tukio) >= 0) {
        kama (foleni_kabla(foleni_hii, tukio) != 0) { endelea; }
        n32 limeshughulikiwa = 0;
        n32 aina = tukio_aina(tukio);
        kama (aina == 2) {                                  // AINPUT_EVENT_TYPE_MOTION
            n32 kitendo = mguso_kitendo(tukio) & 255;
            n32 x = mguso_x(tukio, 0);
            n32 y = mguso_y(tukio, 0);
            kama (kitendo == 0) { kitufe_kilichobonyezwa = kitufe_kilichoguswa(x, y); }        // DOWN
            kama (kitendo == 1) { gusa(x, y); kitufe_kilichobonyezwa = -1; }                     // UP
            kama (kitendo == 3) { kitufe_kilichobonyezwa = -1; }                                 // CANCEL
            limeshughulikiwa = 1;
            omba_fremu_ijayo();
        }
        kama (aina == 1 && ufunguo_namba(tukio) == 4) {     // AKEYCODE_BACK
            kama (ufunguo_kitendo(tukio) == 1) { limeshughulikiwa = nyuma(); omba_fremu_ijayo(); }
            sivyo { limeshughulikiwa = skrini != S_KARIBU && skrini != S_KAJARA && skrini != S_MENYU; }
        }
        foleni_maliza(foleni_hii, tukio, limeshughulikiwa);
    }
    rudisha 1;
}

// ---------------------------------------------------------------- vitendo vya NativeActivity
w0 dirisha_limeundwa(n8* shughuli, n8* dirisha) { dirisha_hili = dirisha; akiba_halali = 0; omba_fremu_ijayo(); }
w0 dirisha_chora_tena(n8* shughuli, n8* dirisha) { dirisha_hili = dirisha; chora(); }
w0 dirisha_limeharibiwa(n8* shughuli, n8* dirisha) { dirisha_hili = 0; }
// programu ikienda nyuma kompyuta husimama (mchezo umehifadhiwa tayari kila
// hatua); ikirudi, skrini huchorwa upya na mchezo huendelea pale pale
w0 imesitishwa(n8* shughuli) { iko_nyuma = 1; }
w0 imerudi(n8* shughuli) { iko_nyuma = 0; akiba_halali = 0; omba_fremu_ijayo(); }

w0 foleni_imeundwa(n8* shughuli, n8* foleni) {
    foleni_hii = foleni;
    foleni_unganisha(foleni, kitanzi_cha_uzi(), 1, &mguso, 0);
}
w0 foleni_imeharibiwa(n8* shughuli, n8* foleni) {
    foleni_tenganisha(foleni);
    foleni_hii = 0;
}

// getWindow().getDecorView().<jina>(int) kwa JNI; kazi_ya_jni ni ya aina ya
// matokeo: 61 CallVoidMethod, 37 CallBooleanMethod (anza huitwa kwenye uzi
// mkuu wa UI, kama mzunguko wa fremu)
w0 ita_mwonekano(n8* jina, n8* saini, n32 kazi_ya_jni, n32 hoja) {
    n8* env = jni_env();
    n8* shughuli = jni_shughuli();
    n64 pata_darasa = jni_kazi(31);
    n64 pata_njia = jni_kazi(33);
    n64 ita_kitu = jni_kazi(34);
    n64 ita = jni_kazi(kazi_ya_jni);
    n64 futa = jni_kazi(23);
    n8* d1 = pata_darasa(env, shughuli);
    n8* dirisha = ita_kitu(env, shughuli, pata_njia(env, d1, "getWindow", "()Landroid/view/Window;"));
    n8* d2 = pata_darasa(env, dirisha);
    n8* mwonekano = ita_kitu(env, dirisha, pata_njia(env, d2, "getDecorView", "()Landroid/view/View;"));
    n8* d3 = pata_darasa(env, mwonekano);
    ita(env, mwonekano, pata_njia(env, d3, jina, saini), hoja);
    futa(env, d3); futa(env, mwonekano); futa(env, d2); futa(env, dirisha); futa(env, d1);
}

// aikoni za upau wa hali: nyeusi juu ya mandhari angavu (SYSTEM_UI_FLAG_LIGHT_STATUS_BAR), nyeupe juu ya giza
w0 upau_wa_hali(n32 giza) {
    n32 bendera = 8192;
    kama (giza) { bendera = 0; }
    ita_mwonekano("setSystemUiVisibility", "(I)V", 61, bendera);
}

// mtetemo mfupi zamu ikifika kwa mchezaji wa simu hii (HapticFeedbackConstants
// LONG_PRESS = 0; hufuata mpangilio wa mtetemo wa mfumo, haihitaji ruhusa)
w0 tetemesha() { ita_mwonekano("performHapticFeedback", "(I)Z", 37, 0); }

// hali ya usiku ya mfumo: getResources().getConfiguration().uiMode & UI_MODE_NIGHT_MASK
// (JNI: CallObjectMethod 34, GetFieldID 94, GetIntField 100). Huulizwa kila
// onConfigurationChanged, kwa hiyo mandhari hufuata mabadiliko ya mfumo papo hapo.
n32 hali_ya_usiku() {
    n8* env = jni_env();
    n8* shughuli = jni_shughuli();
    n64 pata_darasa = jni_kazi(31);
    n64 pata_njia = jni_kazi(33);
    n64 ita_kitu = jni_kazi(34);
    n64 pata_sehemu = jni_kazi(94);
    n64 soma_namba = jni_kazi(100);
    n64 futa = jni_kazi(23);
    n8* d1 = pata_darasa(env, shughuli);
    n8* rasilimali = ita_kitu(env, shughuli, pata_njia(env, d1, "getResources", "()Landroid/content/res/Resources;"));
    n8* d2 = pata_darasa(env, rasilimali);
    n8* mpangilio = ita_kitu(env, rasilimali, pata_njia(env, d2, "getConfiguration", "()Landroid/content/res/Configuration;"));
    n8* d3 = pata_darasa(env, mpangilio);
    n32 hali_ya_ui = soma_namba(env, mpangilio, pata_sehemu(env, d3, "uiMode", "I"));
    futa(env, d3); futa(env, mpangilio); futa(env, d2); futa(env, rasilimali); futa(env, d1);
    rudisha (hali_ya_ui & 48) == 32;
}

w0 fuata_mandhari_ya_mfumo() {
    n32 giza = hali_ya_usiku();
    andaa_mandhari(giza);
    upau_wa_hali(giza);
    akiba_halali = 0;
    omba_fremu_ijayo();
}

w0 mpangilio_umebadilika(n8* shughuli) { fuata_mandhari_ya_mfumo(); }

n32 imeanzishwa = 0;     // mchakato ukiendelea, shughuli mpya huendeleza hali iliyopo

// ANativeActivity_onCreate(shughuli, hali_iliyohifadhiwa, ukubwa): shughuli->callbacks
// iko kwenye baiti 0 na internalDataPath kwenye baiti 32 (android/native_activity.h)
n32 anza(n8* shughuli, n8* hali_iliyohifadhiwa, n64 ukubwa) {
    kama (imeanzishwa == 0) {
        andaa_rangi_za_viti();
        andaa_njia();
        andaa_mtandao();
        n8** sehemu = shughuli;
        njia_ya_data = sehemu[4];
        // fonti kutoka kwenye APK (assets/fonti): Inter (kawaida, wastani, nzito) na Source Serif 4 (vichwa)
        n8* meneja = sehemu[8];
        andaa_fonti();
        fonti_pakia(0, rasilimali_data(rasilimali_fungua(meneja, "fonti/Inter-Regular.ttf", 3)));
        fonti_pakia(1, rasilimali_data(rasilimali_fungua(meneja, "fonti/Inter-Medium.ttf", 3)));
        fonti_pakia(2, rasilimali_data(rasilimali_fungua(meneja, "fonti/Inter-SemiBold.ttf", 3)));
        fonti_pakia(3, rasilimali_data(rasilimali_fungua(meneja, "fonti/SourceSerif4-Semibold.ttf", 3)));
        unda_kitambulisho();
        soma_wasifu();
        nenda(S_KAJARA);
        imeanzishwa = 1;
    }
    fremu_imeombwa = 0;
    andaa_sauti(shughuli);
    fuata_mandhari_ya_mfumo();
    n64* sh = shughuli;
    n64* vitendo = sh[0];
    vitendo[1] = &imerudi;                 // onResume
    vitendo[3] = &imesitishwa;             // onPause
    vitendo[7] = &dirisha_limeundwa;       // onNativeWindowCreated
    vitendo[9] = &dirisha_chora_tena;      // onNativeWindowRedrawNeeded
    vitendo[10] = &dirisha_limeharibiwa;   // onNativeWindowDestroyed
    vitendo[11] = &foleni_imeundwa;        // onInputQueueCreated
    vitendo[12] = &foleni_imeharibiwa;     // onInputQueueDestroyed
    vitendo[14] = &mpangilio_umebadilika;  // onConfigurationChanged (hali ya usiku)
    kumbukumbu(4, "pachisi", "Pachisi ya Swa (Kajara Studio) imeanza");
    rudisha 0;
}
