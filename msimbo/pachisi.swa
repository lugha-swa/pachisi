husisha { maktaba/kumbukumbu.swa }
husisha { maktaba/mfuatano.swa }
husisha { msimbo/herufi.swa }
husisha { msimbo/mantiki.swa }

// pachisi.swa -- Pachisi kwa Android, imeandikwa kwa Swa.
//
// NativeActivity hupakia maktaba hii (bin/swa --arm64-maktaba) na kuita
// `anza`. Kila kitu huchorwa moja kwa moja kwenye pikseli za dirisha
// (ANativeWindow), bila GPU. Kanuni ziko kwenye mantiki.swa, fonti kwenye
// herufi.swa.
//
// Skrini: karibu (lugha) -> kanuni -> mpangilio (aina ya mchezo, wachezaji)
// -> mchezo -> mshindi. Kitufe cha nyuma cha simu hurudi skrini moja.
//
// Ubao: msalaba wa seli 19 x 19 zisizo sawa: mikono ina upana wa nguzo 3 pana
// (A) na urefu wa safu 8 nyembamba (B = A / 2), kwa hiyo seli za njia ni
// mistatili iliyolala kukatiza mkono. Njia ina seli 68 zenye namba 1..68.

nje "libandroid.so" {
    n32 dirisha_weka_umbo(n8* dirisha, n32 upana, n32 urefu, n32 umbo) = "ANativeWindow_setBuffersGeometry";
    n32 dirisha_funga(n8* dirisha, n8* chombo, n8* mipaka) = "ANativeWindow_lock";
    n32 dirisha_onyesha(n8* dirisha) = "ANativeWindow_unlockAndPost";
    n8* kitanzi_cha_uzi() = "ALooper_forThread";
    w0 foleni_unganisha(n8* foleni, n8* kitanzi, n32 kitambulisho, n8* kazi, n8* data) = "AInputQueue_attachLooper";
    w0 foleni_tenganisha(n8* foleni) = "AInputQueue_detachLooper";
    n32 foleni_chukua(n8* foleni, n8** tukio) = "AInputQueue_getEvent";
    n32 foleni_kabla(n8* foleni, n8* tukio) = "AInputQueue_preDispatchEvent";
    w0 foleni_maliza(n8* foleni, n8* tukio, n32 limeshughulikiwa) = "AInputQueue_finishEvent";
    n32 tukio_aina(n8* tukio) = "AInputEvent_getType";
    n32 mguso_kitendo(n8* tukio) = "AMotionEvent_getAction";
    d32 mguso_x(n8* tukio, n64 kidole) = "AMotionEvent_getX";
    d32 mguso_y(n8* tukio, n64 kidole) = "AMotionEvent_getY";
    n32 ufunguo_namba(n8* tukio) = "AKeyEvent_getKeyCode";
    n32 ufunguo_kitendo(n8* tukio) = "AKeyEvent_getAction";
    n8* mpangaji_wa_fremu() = "AChoreographer_getInstance";
    w0 omba_fremu(n8* mpangaji, n8* kazi, n8* data) = "AChoreographer_postFrameCallback64";
}

nje "libc.so" {
    n8* nakili_haraka(n8* lengo, n8* chanzo, n64 ukubwa) = "memcpy";
}

nje "liblog.so" {
    n32 kumbukumbu(n32 kipaumbele, n8* lebo, n8* ujumbe) = "__android_log_write";
}

// ---------------------------------------------------------------- nasibu
n8 chombo_cha_nasibu[1];
n32 kete_nasibu() {
    // getrandom; baiti >= 252 hukataliwa ili kila uso uwe na nafasi sawa
    wakati (1) {
        wito_wa_mfumo(318, chombo_cha_nasibu, 1, 0, 0, 0, 0);
        n32 b = chombo_cha_nasibu[0] & 255;
        kama (b < 252) { rudisha b % 6 + 1; }
    }
    rudisha 1;
}

// ---------------------------------------------------------------- rangi
// RGBA_8888, baiti R G B A -> neno la biti 32 (0xAABBGGRR) kama n32
n32 NYEKUNDU = 0;
n32 KIJANI = 0;
n32 MANJANO = 0;
n32 SAMAWATI = 0;
n32 NYEKUNDU_HAFIFU = 0;
n32 KIJANI_HAFIFU = 0;
n32 MANJANO_HAFIFU = 0;
n32 SAMAWATI_HAFIFU = 0;
n32 NYEUPE = 0;
n32 MANDHARI = 0;
n32 MSTARI = 0;
n32 SALAMA = 0;
n32 KITUFE = 0;
n32 DHAHABU = 0;
n32 GIZA = 0;

w0 andaa_rangi() {
    NYEKUNDU = -13681962;
    KIJANI = -12020178;
    MANJANO = -14633748;
    SAMAWATI = -4298714;
    NYEKUNDU_HAFIFU = -6247696;
    KIJANI_HAFIFU = -5253206;
    MANJANO_HAFIFU = -6888968;
    SAMAWATI_HAFIFU = -1326171;
    NYEUPE = -985094;
    MANDHARI = -15263202;
    MSTARI = -10851208;
    SALAMA = -2899770;
    KITUFE = -13030866;
    DHAHABU = -14629404;
    GIZA = -15790321;
}

n32 rangi_ya(n32 mchezaji, n32 hafifu) {
    kama (mchezaji == 0) { kama (hafifu) { rudisha NYEKUNDU_HAFIFU; } rudisha NYEKUNDU; }
    kama (mchezaji == 1) { kama (hafifu) { rudisha KIJANI_HAFIFU; } rudisha KIJANI; }
    kama (mchezaji == 2) { kama (hafifu) { rudisha MANJANO_HAFIFU; } rudisha MANJANO; }
    kama (hafifu) { rudisha SAMAWATI_HAFIFU; }
    rudisha SAMAWATI;
}

