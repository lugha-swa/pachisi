husisha { maktaba/kumbukumbu.swa }
husisha { maktaba/mfuatano.swa }

// pachisi.swa -- Pachisi kwa Android, ulioandikwa kwa Swa.
//
// NativeActivity hupakia maktaba hii (bin/swa --arm64-maktaba) na kuita
// `anza`. Tunasajili vitendo vya dirisha na vya mguso; dirisha likiwa tayari,
// ubao huchorwa moja kwa moja kwenye pikseli za dirisha (ANativeWindow), bila
// GPU. Kwa sasa kila mguso hupitisha zamu kwa mchezaji anayefuata.
//
// Ubao: msalaba wa seli 19 x 19. Kila mkono una safu 3 kwa urefu wa seli 8;
// safu mbili za nje ni njia, ya katikati ni njia ya nyumbani (seli 7) ya
// mchezaji wa mkono huo. Njia ina seli 68 (17 kwa kila mkono) zinazozunguka
// kisaa; seli 12 ni salama (3 kwa kila mkono). Pembe nne ni viota, katikati
// ni nyumbani. Wachezaji: 0 nyekundu (mkono wa kushoto), 1 kijani (juu),
// 2 manjano (kulia), 3 samawati (chini).

nje "libandroid.so" {
    n32 dirisha_weka_umbo(n8* dirisha, n32 upana, n32 urefu, n32 umbo) = "ANativeWindow_setBuffersGeometry";
    n32 dirisha_funga(n8* dirisha, n8* chombo, n8* mipaka) = "ANativeWindow_lock";
    n32 dirisha_onyesha(n8* dirisha) = "ANativeWindow_unlockAndPost";
    n8* kitanzi_cha_uzi() = "ALooper_forThread";
    w0 foleni_unganisha(n8* foleni, n8* kitanzi, n32 kitambulisho, n8* kazi, n8* data) = "AInputQueue_attachLooper";
    w0 foleni_tenganisha(n8* foleni) = "AInputQueue_detachLooper";
    n32 foleni_chukua(n8* foleni, n8** tukio) = "AInputQueue_getEvent";
    n32 foleni_kabla(n8* foleni, n8* tukio) = "AInputQueue_preDispatchEvent";
    w0 foleni_maliza(n8* foleni, n8* tukio, n32 limeshughulikiwa) = "AInputQueue_finishEvent";
    n32 tukio_aina(n8* tukio) = "AInputEvent_getType";
    n32 mguso_kitendo(n8* tukio) = "AMotionEvent_getAction";
}

nje "liblog.so" {
    n32 kumbukumbu(n32 kipaumbele, n8* lebo, n8* ujumbe) = "__android_log_write";
}

// rangi: RGBA_8888, baiti R G B A -> neno la biti 32 (0xAABBGGRR) kama n32
n32 NYEKUNDU = 0;
n32 KIJANI = 0;
n32 MANJANO = 0;
n32 SAMAWATI = 0;
n32 NYEKUNDU_HAFIFU = 0;
n32 KIJANI_HAFIFU = 0;
n32 MANJANO_HAFIFU = 0;
n32 SAMAWATI_HAFIFU = 0;
n32 NYEUPE = 0;
n32 MANDHARI = 0;
n32 MSTARI = 0;

// vigeu vya ulimwengu vyenye usemi huwekwa wakati wa kuanza
w0 andaa_rangi() {
    NYEKUNDU = 0 - 13681962;
    KIJANI = 0 - 12020178;
    MANJANO = 0 - 14633748;
    SAMAWATI = 0 - 4298714;
    NYEKUNDU_HAFIFU = 0 - 6247696;
    KIJANI_HAFIFU = 0 - 5253206;
    MANJANO_HAFIFU = 0 - 6888968;
    SAMAWATI_HAFIFU = 0 - 1326171;
    NYEUPE = 0 - 985094;
    MANDHARI = 0 - 15263202;
    MSTARI = 0 - 10851208;
}

n8* dirisha_hili = 0;
n8* foleni_hii = 0;
n32 zamu = 0;              // 0 nyekundu, 1 kijani, 2 manjano, 3 samawati

// jiometri ya ubao (hukokotolewa kila mchoro)
n32* pikseli = 0;
n32 hatua = 0;             // pikseli kwa kila mstari wa skrini
n32 upana_wa_skrini = 0;
n32 urefu_wa_skrini = 0;
n32 seli = 0;
n32 ubao_x = 0;
n32 ubao_y = 0;

w0 mstatili(n32 x, n32 y, n32 upana, n32 urefu, n32 rangi) {
    kama (x < 0) { upana = upana + x; x = 0; }
    kama (y < 0) { urefu = urefu + y; y = 0; }
    kama (x + upana > upana_wa_skrini) { upana = upana_wa_skrini - x; }
    kama (y + urefu > urefu_wa_skrini) { urefu = urefu_wa_skrini - y; }
    n32 j = 0;
    wakati (j < urefu) {
        n32 mwanzo = (y + j) * hatua + x;
        n32 i = 0;
        wakati (i < upana) { pikseli[mwanzo + i] = rangi; i = i + 1; }
        j = j + 1;
    }
}

// seli moja ya njia: mpaka wa pikseli 1 na ndani ya rangi
w0 seli_ya_njia(n32 safu, n32 safu_wima, n32 rangi) {
    n32 x = ubao_x + safu_wima * seli;
    n32 y = ubao_y + safu * seli;
    mstatili(x, y, seli, seli, MSTARI);
    mstatili(x + 1, y + 1, seli - 2, seli - 2, rangi);
}

w0 duara(n32 cx, n32 cy, n32 nusu, n32 rangi) {
    n32 kipenyo = nusu * 2;
    n32 j = 0;
    wakati (j <= kipenyo) {
        n32 dy = j - nusu;
        n32 i = 0;
        wakati (i <= kipenyo) {
            n32 dx = i - nusu;
            kama (dx * dx + dy * dy <= nusu * nusu) {
                n32 x = cx + dx;
                n32 y = cy + dy;
                kama (x >= 0 && y >= 0 && x < upana_wa_skrini && y < urefu_wa_skrini) { pikseli[y * hatua + x] = rangi; }
            }
            i = i + 1;
        }
        j = j + 1;
    }
}

n32 rangi_ya(n32 mchezaji, n32 hafifu) {
    kama (mchezaji == 0) { kama (hafifu) { rudisha NYEKUNDU_HAFIFU; } rudisha NYEKUNDU; }
    kama (mchezaji == 1) { kama (hafifu) { rudisha KIJANI_HAFIFU; } rudisha KIJANI; }
    kama (mchezaji == 2) { kama (hafifu) { rudisha MANJANO_HAFIFU; } rudisha MANJANO; }
    kama (hafifu) { rudisha SAMAWATI_HAFIFU; }
    rudisha SAMAWATI;
}

// ---------------------------------------------------------------- njia
// seli 68 za njia, kisaa kuanzia mkono wa kushoto (nyekundu): mstari wa chini
// wa mkono kuelekea nje, seli ya mwisho, mstari wa juu kuelekea katikati, kisha
// mkono unaofuata. Mkono m huanzia faharisi 17 * m.
n32 NJIA_SAFU[68];
n32 NJIA_WIMA[68];
n32 NJIA_SEHEMU = 17;
n32 SEHEMU_YA_KUINGIA = 13;      // seli ya kuingia (rangi ya mchezaji, salama)
n32 SEHEMU_YA_KINYUME = 4;       // salama: mkabala na seli ya kuingia
n32 SEHEMU_YA_MWISHO = 8;        // salama: ncha ya mkono, mlango wa njia ya nyumbani

// mzunguko wa robo kisaa kuzunguka katikati ya ubao (9, 9)
w0 zungusha_robo(n32* safu, n32* wima) {
    n32 s = safu[0];
    n32 w = wima[0];
    safu[0] = w;
    wima[0] = 18 - s;
}

w0 andaa_njia() {
    // mkono wa kushoto (m = 0), kisha kila mkono mwingine ni mzunguko wa robo
    n32 m = 0;
    wakati (m < 4) {
        n32 i = 0;
        wakati (i < NJIA_SEHEMU) {
            n32 s = 0;
            n32 w = 0;
            kama (i < 8) { s = 10; w = 7 - i; }
            kama (i == 8) { s = 9; w = 0; }
            kama (i > 8) { s = 8; w = i - 9; }
            n32 r = 0;
            wakati (r < m) { zungusha_robo(&s, &w); r = r + 1; }
            NJIA_SAFU[m * NJIA_SEHEMU + i] = s;
            NJIA_WIMA[m * NJIA_SEHEMU + i] = w;
            i = i + 1;
        }
        m = m + 1;
    }
}

n32 ni_salama(n32 faharisi) {
    n32 i = faharisi % NJIA_SEHEMU;
    rudisha i == SEHEMU_YA_KUINGIA || i == SEHEMU_YA_KINYUME || i == SEHEMU_YA_MWISHO;
}

// njia ya nyumbani ya mchezaji m, hatua h (0..6): mstari wa kati wa mkono wake
w0 seli_ya_nyumbani(n32 m, n32 h, n32* safu, n32* wima) {
    safu[0] = 9;
    wima[0] = h + 1;
    n32 r = 0;
    wakati (r < m) { zungusha_robo(safu, wima); r = r + 1; }
}

// kiota cha mchezaji: mraba wa seli 8 kwenye pembe, ndani mduara mweupe, pauni nne
w0 kiota(n32 safu, n32 safu_wima, n32 rangi) {
    n32 x = ubao_x + safu_wima * seli;
    n32 y = ubao_y + safu * seli;
    mstatili(x, y, seli * 8, seli * 8, rangi);
    duara(x + seli * 4, y + seli * 4, seli * 3, NYEUPE);
    n32 nusu = seli * 2 / 5;
    duara(x + seli * 3, y + seli * 3, nusu, rangi);
    duara(x + seli * 5, y + seli * 3, nusu, rangi);
    duara(x + seli * 3, y + seli * 5, nusu, rangi);
    duara(x + seli * 5, y + seli * 5, nusu, rangi);
}

w0 chora_ubao() {
    mstatili(0, 0, upana_wa_skrini, urefu_wa_skrini, MANDHARI);
    n32 dogo = upana_wa_skrini;
    kama (urefu_wa_skrini < dogo) { dogo = urefu_wa_skrini; }
    seli = dogo * 94 / 100 / 19;
    n32 ubao = seli * 19;
    ubao_x = (upana_wa_skrini - ubao) / 2;
    ubao_y = (urefu_wa_skrini - ubao) / 2;
    mstatili(ubao_x - 4, ubao_y - 4, ubao + 8, ubao + 8, MSTARI);
    mstatili(ubao_x, ubao_y, ubao, ubao, NYEUPE);

    // njia: seli 68, za kuingia kwa rangi ya mchezaji, salama zina alama
    n32 i = 0;
    wakati (i < 68) {
        n32 m = i / NJIA_SEHEMU;
        n32 rangi = NYEUPE;
        kama (i % NJIA_SEHEMU == SEHEMU_YA_KUINGIA) { rangi = rangi_ya(m, zamu != m); }
        seli_ya_njia(NJIA_SAFU[i], NJIA_WIMA[i], rangi);
        kama (ni_salama(i)) {
            n32 cx = ubao_x + NJIA_WIMA[i] * seli + seli / 2;
            n32 cy = ubao_y + NJIA_SAFU[i] * seli + seli / 2;
            duara(cx, cy, seli / 4, MSTARI);
        }
        i = i + 1;
    }
    // njia za nyumbani: seli 7 kwa kila mchezaji
    n32 m = 0;
    wakati (m < 4) {
        n32 h = 0;
        wakati (h < 7) {
            n32 s = 0;
            n32 w = 0;
            seli_ya_nyumbani(m, h, &s, &w);
            seli_ya_njia(s, w, rangi_ya(m, zamu != m));
            h = h + 1;
        }
        m = m + 1;
    }

    // viota vinne: cha mwenye zamu kina rangi kamili, vingine hafifu
    kiota(0, 0, rangi_ya(0, zamu != 0));
    kiota(0, 11, rangi_ya(1, zamu != 1));
    kiota(11, 11, rangi_ya(2, zamu != 2));
    kiota(11, 0, rangi_ya(3, zamu != 3));

    // nyumbani: pembetatu nne zinazoelekea njia za nyumbani
    n32 x0 = ubao_x + seli * 8;
    n32 y0 = ubao_y + seli * 8;
    n32 kati = seli * 3;
    n32 py = 0;
    wakati (py < kati) {
        n32 px = 0;
        wakati (px < kati) {
            n32 a = px * 2 - kati;
            n32 b = py * 2 - kati;
            n32 aa = a; kama (aa < 0) { aa = 0 - aa; }
            n32 bb = b; kama (bb < 0) { bb = 0 - bb; }
            n32 mchezaji = 0;
            kama (bb >= aa) { kama (b < 0) { mchezaji = 1; } sivyo { mchezaji = 3; } }
            sivyo { kama (a < 0) { mchezaji = 0; } sivyo { mchezaji = 2; } }
            pikseli[(y0 + py) * hatua + x0 + px] = rangi_ya(mchezaji, zamu != mchezaji);
            px = px + 1;
        }
        py = py + 1;
    }
}

n8 chombo_cha_dirisha[48];

w0 chora() {
    kama (dirisha_hili == 0) { rudisha; }
    dirisha_weka_umbo(dirisha_hili, 0, 0, 1);          // WINDOW_FORMAT_RGBA_8888
    kama (dirisha_funga(dirisha_hili, chombo_cha_dirisha, 0) != 0) { rudisha; }
    n32* vipimo = chombo_cha_dirisha;
    upana_wa_skrini = vipimo[0];
    urefu_wa_skrini = vipimo[1];
    hatua = vipimo[2];
    n8** anwani = chombo_cha_dirisha;       // ANativeWindow_Buffer.bits: baiti 16 = kielekezi cha 3
    n8* baiti_za_pikseli = anwani[2];
    pikseli = baiti_za_pikseli;
    chora_ubao();
    dirisha_onyesha(dirisha_hili);
}

// ---------------------------------------------------------------- vitendo vya NativeActivity
w0 dirisha_limeundwa(n8* shughuli, n8* dirisha) { dirisha_hili = dirisha; chora(); }
w0 dirisha_chora_tena(n8* shughuli, n8* dirisha) { dirisha_hili = dirisha; chora(); }
w0 dirisha_limeharibiwa(n8* shughuli, n8* dirisha) { dirisha_hili = 0; }

n32 mguso(n32 kishikio, n32 matukio, n8* data) {
    n8* tukio = 0;
    wakati (foleni_hii != 0 && foleni_chukua(foleni_hii, &tukio) >= 0) {
        kama (foleni_kabla(foleni_hii, tukio) != 0) { endelea; }
        n32 limeshughulikiwa = 0;
        kama (tukio_aina(tukio) == 2) {                    // AINPUT_EVENT_TYPE_MOTION
            kama ((mguso_kitendo(tukio) & 255) == 0) {      // AMOTION_EVENT_ACTION_DOWN
                zamu = (zamu + 1) % 4;
                chora();
            }
            limeshughulikiwa = 1;
        }
        foleni_maliza(foleni_hii, tukio, limeshughulikiwa);
    }
    rudisha 1;
}

w0 foleni_imeundwa(n8* shughuli, n8* foleni) {
    foleni_hii = foleni;
    foleni_unganisha(foleni, kitanzi_cha_uzi(), 1, &mguso, 0);
}
w0 foleni_imeharibiwa(n8* shughuli, n8* foleni) {
    foleni_tenganisha(foleni);
    foleni_hii = 0;
}

// ANativeActivity_onCreate(shughuli, hali_iliyohifadhiwa, ukubwa): shughuli->callbacks iko
// kwenye umbali 0; kila kitendo ni sloti ya baiti 8 (android/native_activity.h)
n32 anza(n8* shughuli, n8* hali_iliyohifadhiwa, n64 ukubwa) {
    andaa_rangi();
    andaa_njia();
    n64* sh = shughuli;
    n64* vitendo = sh[0];
    vitendo[7] = &dirisha_limeundwa;       // onNativeWindowCreated
    vitendo[9] = &dirisha_chora_tena;      // onNativeWindowRedrawNeeded
    vitendo[10] = &dirisha_limeharibiwa;   // onNativeWindowDestroyed
    vitendo[11] = &foleni_imeundwa;        // onInputQueueCreated
    vitendo[12] = &foleni_imeharibiwa;     // onInputQueueDestroyed
    kumbukumbu(4, "pachisi", "Pachisi ya Swa imeanza");
    rudisha 0;
}
