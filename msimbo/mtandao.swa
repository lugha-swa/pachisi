// mtandao.swa -- vyumba vya Wi-Fi: simu moja ni mwenyeji (huendesha kanuni),
// nyingine hujiunga kwenye mtandao ule ule.
//
//   UDP 47474: mwenyeji hutangaza chumba kila sekunde kwenye anwani ya
//              matangazo ya KILA kiolesura chenye matangazo (Wi-Fi, hotspot ya
//              simu hii, ethernet) -- violesura husomwa kutoka mfumo (getifaddrs)
//              kila tangazo, kwa hiyo hotspot ikiwashwa baadaye huonekana pia:
//              "PCH1" + nambari ya chumba (4) + jina (16) + bandari ya mchezo (2)
//   TCP:       wateja huunganisha kwenye bandari iliyotangazwa; mwenyeji huchagua
//              bandari ya kwanza iliyo wazi kuanzia 47475. Bandari ya tangazo
//              pekee ndiyo isiyobadilika: ni mahali pa kukutana.
//
// Kila ujumbe wa TCP ni fremu: [aina, kiti, urefu (baiti 2, LE)] + data.
//   aina 1: hali kutoka kwa mwenyeji (baiti 448: n32[80] + majina 4 x 16 +
//           vitambulisho vya wachezaji 4 x 12)
//   aina 2: ombi la mteja (baiti 32): [ombi, a, b, toleo] + jina (baiti 16)
//           + kitambulisho (baiti 12);
//           ombi 1 = rusha, 2 = sogeza pauni a kwa hatua b, 3 = dai kiti a,
//           4 = salamu, 5 = nitumie APK
//   aina 3: sauti: PCM i16 ya 16 kHz ya kiti `kiti` (mwenyeji huipeleka kwa wengine)
//   aina 4: ofa ya sasisho: n32 toleo, n32 ukubwa wa APK
//   aina 5: kipande cha APK (hadi baiti 4096, kwa mpangilio)
// Mteja hulinganisha hali mpya na ya zamani ili kuhuisha kete na hatua kama
// mchezo wa simu moja.

nje "libc.so" {
    n32 tundu_jipya(n32 familia, n32 aina, n32 itifaki) = "socket";
    n32 tundu_funga_anwani(n32 tundu, n8* anwani, n32 urefu) = "bind";
    n32 tundu_sikiliza(n32 tundu, n32 foleni) = "listen";
    n32 tundu_pokea_muunganiko(n32 tundu, n8* anwani, n8* urefu) = "accept";
    n32 tundu_unganisha(n32 tundu, n8* anwani, n32 urefu) = "connect";
    n64 tundu_tuma(n32 tundu, n8* data, n64 urefu, n32 bendera) = "send";
    n64 tundu_pokea(n32 tundu, n8* data, n64 urefu, n32 bendera) = "recv";
    n64 tundu_tuma_kwa(n32 tundu, n8* data, n64 urefu, n32 bendera, n8* anwani, n32 urefu_a) = "sendto";
    n64 tundu_pokea_kutoka(n32 tundu, n8* data, n64 urefu, n32 bendera, n8* anwani, n8* urefu_a) = "recvfrom";
    n32 tundu_chaguo(n32 tundu, n32 ngazi, n32 jina, n8* thamani, n32 urefu) = "setsockopt";
    n32 tundu_udhibiti(n32 tundu, n32 amri, n32 hoja) = "fcntl";
    n32 tundu_funga(n32 tundu) = "close";
    n32 subiri_matukio(n8* matukio, n64 idadi, n32 muda) = "poll";
    n32 tundu_soma_chaguo(n32 tundu, n32 ngazi, n32 jina, n8* thamani, n8* urefu) = "getsockopt";
    n32 orodha_ya_violesura(n8** orodha) = "getifaddrs";
    w0 achilia_violesura(n8* orodha) = "freeifaddrs";
}

n32 BANDARI_YA_TANGAZO = 47474;
n32 BANDARI_YA_MCHEZO = 47475;     // ya kwanza kujaribiwa; mwenyeji hutangaza aliyopata
n32 bandari_ya_chumba = 0;
n32 MSG_DONTWAIT = 64;
n32 MSG_NOSIGNAL = 16384;

n32 jukumu_la_mtandao = 0;      // 0 hakuna, 1 mwenyeji, 2 mteja, 3 anatafuta, 4 anaunganisha
n32 kuunganisha_mwanzo = 0;
n32 kosa_la_kuunganisha = 0;    // ms ya kosa la mwisho la kujiunga (huonyeshwa sekunde 3)
n32 tundu_la_tangazo = -1;
n32 tundu_la_kusikiliza = -1;
n32 tundu_la_mteja[3];          // mwenyeji: wateja; mteja: [0] ni mwenyeji
n32 nafasi_ya_mteja = -1;       // mteja: nambari yake kwa mwenyeji (1..3)
n32 chumba_kimesimamishwa = 0;   // mwenyeji amesimamisha mchezo kwa muda
n32 kuunganisha_upya = 0;        // mteja: muunganiko ulikatika katikati ya mchezo
n32 mmiliki[4];                 // -1 wazi, 0 mwenyeji, 1..3 mteja
n8 majina_ya_viti[64];
n32 tangazo_la_mwisho = 0;

// vyumba vilivyosikika (mteja)
n32 vyumba_n = 0;
n8 vyumba_anwani[80];           // sockaddr_in (16) x 5
n8 vyumba_jina[120];            // "NNNN JINA" (24) x 5
n32 vyumba_muda[5];

// chombo cha kupokea kwa kila muunganiko (TCP ni mfululizo wa baiti)
n32 MAPOKEZI = 8192;
n8 chombo_cha_mapokezi[24576];  // 3 x 8192
n32 kiasi_cha_mapokezi[3];

w0 sauti_pokea(n32 kiti, n8* data, n32 urefu);

// foleni ya kutuma kwa kila muunganiko. Tundu haizuii, kwa hiyo send inaweza
// kukubali sehemu tu ya fremu; kilichobaki husubiri hapa na hutumwa tiki
// inayofuata, ili mfululizo wa fremu usivunjike. Sauti ikikuta foleni haijaisha
// huachwa: sauti iliyochelewa haina maana, na ingechelewesha hatua za mchezo.
n32 FOLENI = 16384;
n8 foleni_ya_kutuma[49152];     // 3 x 16384
n32 kiasi_cha_foleni[3];
n32 muunganiko_umevunjika[3];   // foleni ilijaa: mwenzake hapokei tena

// toleo la programu hii (pia versionCode ya APK, jenga-apk.sh). Mteja hulituma
// kwenye salamu; mwenyeji mwenye toleo jipya zaidi humpa ofa ya kusasisha na,
// akikubali, humtumia APK yake mwenyewe vipande vipande (aina 4 na 5).
n32 TOLEO_LA_PROGRAMU = 3;
n32 toleo_la_programu() { rudisha TOLEO_LA_PROGRAMU; }
n32 upakiaji[3];                // mwenyeji: baiti za APK zilizotumwa kwa mteja i, au -1
n8 kipande_cha_apk[4096];
n32 apk_ukubwa_wangu();
n32 apk_soma(n32 nafasi, n8* chombo, n32 urefu);
w0 sasisho_ofa(n32 toleo, n32 ukubwa);
w0 sasisho_kipande(n8* data, n32 urefu);

w0 sukuma_foleni(n32 i) {
    kama (tundu_la_mteja[i] < 0 || kiasi_cha_foleni[i] == 0) { rudisha; }
    n8* f = foleni_ya_kutuma + i * FOLENI;
    n64 n = tundu_tuma(tundu_la_mteja[i], f, kiasi_cha_foleni[i], MSG_NOSIGNAL | MSG_DONTWAIT);
    kama (n > 0) {
        nakili(f, f + n, kiasi_cha_foleni[i] - n);
        kiasi_cha_foleni[i] = kiasi_cha_foleni[i] - n;
    }
}

w0 tuma_fremu(n32 i, n32 aina, n32 kiti, n8* data, n32 urefu) {
    kama (tundu_la_mteja[i] < 0 || urefu > 4096) { rudisha; }
    kama (aina == 3 && kiasi_cha_foleni[i] > 0) { rudisha; }
    kama (kiasi_cha_foleni[i] + urefu + 4 > FOLENI) { muunganiko_umevunjika[i] = 1; rudisha; }
    n8* f = foleni_ya_kutuma + i * FOLENI + kiasi_cha_foleni[i];
    f[0] = aina;
    f[1] = kiti;
    f[2] = urefu & 255;
    f[3] = (urefu >> 8) & 255;
    nakili(f + 4, data, urefu);
    kiasi_cha_foleni[i] = kiasi_cha_foleni[i] + urefu + 4;
    sukuma_foleni(i);
}


w0 anwani_ya_ipv4(n8* a, n32 ip_juu, n32 bandari) {
    n32 i = 0;
    wakati (i < 16) { a[i] = 0; i = i + 1; }
    a[0] = 2;                                      // AF_INET (mpangilio wa mashine)
    a[2] = (bandari >> 8) & 255;                   // bandari kwa mpangilio wa mtandao
    a[3] = bandari & 255;
    a[4] = (ip_juu >> 24) & 255;
    a[5] = (ip_juu >> 16) & 255;
    a[6] = (ip_juu >> 8) & 255;
    a[7] = ip_juu & 255;
}

w0 bila_kuzuia(n32 tundu) {
    n32 bendera = tundu_udhibiti(tundu, 3, 0);     // F_GETFL
    tundu_udhibiti(tundu, 4, bendera | 2048);      // F_SETFL, O_NONBLOCK
}

// violesura vya IPv4 vilivyo hai vyenye matangazo (si loopback, si data ya
// simu ambayo ni ya nukta-kwa-nukta): Wi-Fi, hotspot, ethernet. struct ifaddrs
// kwenye 64-bit: ifa_next 0, ifa_flags 16, ifa_addr 24, ifa_netmask 32.
n32 violesura_n = 0;
n32 violesura_ip[8];
n32 violesura_matangazo[8];

n32 ip_ya_anwani(n8* a) {
    rudisha ((a[4] & 255) << 24) | ((a[5] & 255) << 16) | ((a[6] & 255) << 8) | (a[7] & 255);
}

w0 soma_violesura() {
    violesura_n = 0;
    n8* orodha = 0;
    kama (orodha_ya_violesura(&orodha) != 0) { rudisha; }
    n8* p = orodha;
    wakati (p != 0 && violesura_n < 8) {
        n8** sehemu = p;
        n32* bendera_p = p + 16;
        n32 bendera = bendera_p[0];
        n8* anwani = sehemu[3];
        n8* kinyago = sehemu[4];
        n32 hai = (bendera & 1) != 0 && (bendera & 2) != 0 && (bendera & 8) == 0;   // UP, BROADCAST, si LOOPBACK
        kama (hai && anwani != 0 && kinyago != 0 && (anwani[0] & 255) == 2) {
            n32 ip = ip_ya_anwani(anwani);
            n32 kinyago_ip = ip_ya_anwani(kinyago);
            violesura_ip[violesura_n] = ip;
            violesura_matangazo[violesura_n] = ip | (-1 - kinyago_ip);
            violesura_n = violesura_n + 1;
        }
        p = sehemu[0];
    }
    achilia_violesura(orodha);
}

w0 chaguo_moja(n32 tundu, n32 ngazi, n32 jina) {
    n32 moja[1];
    moja[0] = 1;
    tundu_chaguo(tundu, ngazi, jina, moja, 4);
}

// muunganiko mpya: hauzuii, na fremu ndogo hutumwa mara moja (TCP_NODELAY)
// badala ya kusubiri kuunganishwa na nyingine (Nagle huongeza hadi ms 200)
w0 anza_muunganiko(n32 i, n32 tundu) {
    bila_kuzuia(tundu);
    chaguo_moja(tundu, 6, 1);                      // IPPROTO_TCP, TCP_NODELAY
    tundu_la_mteja[i] = tundu;
    kiasi_cha_mapokezi[i] = 0;
    kiasi_cha_foleni[i] = 0;
    muunganiko_umevunjika[i] = 0;
    upakiaji[i] = -1;
}

// mwenyeji: jaza foleni ya mteja i kwa vipande vya APK, bila kuzidi nafasi yake
w0 tuma_vipande_vya_apk(n32 i) {
    kama (tundu_la_mteja[i] < 0 || upakiaji[i] < 0) { rudisha; }
    n32 u = apk_ukubwa_wangu();
    wakati (upakiaji[i] < u && kiasi_cha_foleni[i] + 4100 <= FOLENI) {
        n32 n = u - upakiaji[i];
        kama (n > 4096) { n = 4096; }
        kama (apk_soma(upakiaji[i], kipande_cha_apk, n) != n) { upakiaji[i] = -1; rudisha; }
        tuma_fremu(i, 5, 0, kipande_cha_apk, n);
        upakiaji[i] = upakiaji[i] + n;
    }
    kama (upakiaji[i] >= u) { upakiaji[i] = -1; }
}

w0 mtandao_funga() {
    kama (tundu_la_tangazo >= 0) { tundu_funga(tundu_la_tangazo); }
    kama (tundu_la_kusikiliza >= 0) { tundu_funga(tundu_la_kusikiliza); }
    n32 i = 0;
    wakati (i < 3) {
        kama (tundu_la_mteja[i] >= 0) { tundu_funga(tundu_la_mteja[i]); }
        tundu_la_mteja[i] = -1;
        kiasi_cha_mapokezi[i] = 0;
        kiasi_cha_foleni[i] = 0;
        i = i + 1;
    }
    tundu_la_tangazo = -1;
    tundu_la_kusikiliza = -1;
    jukumu_la_mtandao = 0;
    nafasi_ya_mteja = -1;
    kuunganisha_upya = 0;
    chumba_kimesimamishwa = 0;
    vyumba_n = 0;
    i = 0;
    wakati (i < 4) { mmiliki[i] = -1; i = i + 1; }
}

// urefu wote wa fremu ya kwanza ikiwa imekamilika ndani ya chombo, au 0
n32 fremu_kamili(n8* c, n32 kiasi) {
    kama (kiasi < 4) { rudisha 0; }
    n32 urefu = (c[2] & 255) | ((c[3] & 255) << 8);
    kama (kiasi < urefu + 4) { rudisha 0; }
    rudisha urefu + 4;
}

n32 mtandao_ni_mwenyeji() { rudisha jukumu_la_mtandao == 1; }
n32 mtandao_ni_mteja() { rudisha jukumu_la_mtandao == 2; }
n32 mtandao_vyumba_idadi() { rudisha vyumba_n; }
n8* mtandao_jina_la_chumba(n32 i) { rudisha vyumba_jina + i * 24; }
n32 mmiliki_wa_kiti(n32 m) { rudisha mmiliki[m]; }
n8* jina_la_kiti(n32 m) { rudisha majina_ya_viti + m * 16; }

n32 kiti_changu() {
    n32 mimi = 0;
    kama (jukumu_la_mtandao == 2) { mimi = nafasi_ya_mteja; }
    n32 m = 0;
    wakati (m < 4) { kama (mmiliki[m] == mimi && mimi >= 0) { rudisha m; } m = m + 1; }
    rudisha -1;
}

w0 weka_jina_la_kiti(n32 m, n8* jina) {
    n32 i = 0;
    wakati (i < 15 && jina[i] != 0) { majina_ya_viti[m * 16 + i] = jina[i]; i = i + 1; }
    majina_ya_viti[m * 16 + i] = 0;
}

// ---------------------------------------------------------------- mwenyeji
w0 weka_kitambulisho_cha_kiti(n32 m, n8* kitambulisho_chake);
w0 mtandao_anza_mwenyeji() {
    mtandao_funga();
    n8 a[16];
    tundu_la_kusikiliza = tundu_jipya(2, 1, 0);    // TCP
    kama (tundu_la_kusikiliza < 0) { rudisha; }
    chaguo_moja(tundu_la_kusikiliza, 1, 2);        // SO_REUSEADDR
    // bandari ya kwanza iliyo wazi kati ya 10
    bandari_ya_chumba = BANDARI_YA_MCHEZO;
    anwani_ya_ipv4(a, 0, bandari_ya_chumba);
    wakati (tundu_funga_anwani(tundu_la_kusikiliza, a, 16) != 0) {
        bandari_ya_chumba = bandari_ya_chumba + 1;
        kama (bandari_ya_chumba >= BANDARI_YA_MCHEZO + 10) { mtandao_funga(); rudisha; }
        anwani_ya_ipv4(a, 0, bandari_ya_chumba);
    }
    tundu_sikiliza(tundu_la_kusikiliza, 4);
    bila_kuzuia(tundu_la_kusikiliza);
    tundu_la_tangazo = tundu_jipya(2, 2, 0);       // UDP
    chaguo_moja(tundu_la_tangazo, 1, 6);           // SO_BROADCAST
    bila_kuzuia(tundu_la_tangazo);
    jukumu_la_mtandao = 1;
    // nambari ya chumba: tarakimu 4 za nasibu
    n8 nasibu[4];
    wito_wa_mfumo(318, nasibu, 4, 0, 0, 0, 0);
    n32 i = 0;
    wakati (i < 4) { nambari_ya_chumba[i] = 48 + (nasibu[i] & 255) % 10; i = i + 1; }
    nambari_ya_chumba[4] = 0;
    // mwenyeji huchukua kiti cha kwanza; vingine viko wazi
    i = 0;
    wakati (i < 4) { mmiliki[i] = -1; kiti_kipo[i] = 1; i = i + 1; }
    mmiliki[0] = 0;
    weka_jina_la_kiti(0, jina_la_mchezaji);
    i = 0;
    wakati (i < 4) { weka_kitambulisho_cha_kiti(i, 0); i = i + 1; }
    weka_kitambulisho_cha_kiti(0, kitambulisho);
    chumba_kimesimamishwa = 0;
}


// Mchezo wa chumba huishi hata mtu akikatika: kiti chake hushikiliwa
// (mmiliki -2) kwa kitambulisho chake (KJ-XXXX-XXXX) mpaka arudi, na zamu yake
// husubiri; mwenyeji anaweza kuiachia kompyuta. Mwenyeji huhifadhi hali kwenye
// faili "chumba" kila inapobadilika, kwa hiyo hata mwenyeji akifunga programu,
// anaweza kuendeleza chumba kilekile baadaye na wengine wakarudi viti vyao.
n32 HALI_UREFU = 448;
n32 KITI_KINASUBIRI = -2;
n8 chombo_cha_hali[448];
n8 vitambulisho_vya_viti[48];

w0 weka_kitambulisho_cha_kiti(n32 m, n8* kitambulisho_chake) {
    n32 i = 0;
    wakati (i < 12) {
        vitambulisho_vya_viti[m * 12 + i] = 0;
        kama (kitambulisho_chake != 0) { vitambulisho_vya_viti[m * 12 + i] = kitambulisho_chake[i]; }
        i = i + 1;
    }
}

n32 kitambulisho_cha_kiti_ni(n32 m, n8* kitambulisho_chake) {
    kama (kitambulisho_chake == 0 || vitambulisho_vya_viti[m * 12] == 0) { rudisha 0; }
    n32 i = 0;
    wakati (i < 12) { kama (vitambulisho_vya_viti[m * 12 + i] != kitambulisho_chake[i]) { rudisha 0; } i = i + 1; }
    rudisha 1;
}

w0 jaza_hali(n32 kwa_mteja) {
    n32* v = chombo_cha_hali;
    v[0] = 1346913107;                // "SHCP"
    n32 i = 0;
    wakati (i < 4) { v[1 + i] = kiti_kipo[i]; v[5 + i] = ni_kompyuta[i]; v[9 + i] = rangi_ya_kiti[i]; v[13 + i] = mmiliki[i]; i = i + 1; }
    i = 0;
    wakati (i < 16) { v[17 + i] = pauni[i]; i = i + 1; }
    v[33] = zamu; v[34] = kete[0]; v[35] = kete[1];
    i = 0;
    wakati (i < 8) { v[36 + i] = hatua[i]; v[44 + i] = hatua_ni_kete[i]; i = i + 1; }
    v[52] = idadi_ya_hatua; v[53] = hali_ya_zamu; v[54] = ujumbe; v[55] = ujumbe_wa_mchezaji;
    v[56] = mshindi; v[57] = pacha_mfululizo; v[58] = ilikuwa_pacha;
    v[59] = SHERIA_KUINGIA; v[60] = SHERIA_ZAWADI_YA_KULA; v[61] = SHERIA_ZAWADI_YA_NYUMBANI;
    v[62] = SHERIA_VIZUIZI; v[63] = SHERIA_SALAMA; v[64] = SHERIA_PACHA_TATU; v[65] = PAUNI_KWA_MCHEZAJI;
    v[66] = kwa_mteja;
    v[67] = skrini == S_MCHEZO;
    i = 0;
    wakati (i < 4) { v[68 + i] = nambari_ya_chumba[i]; v[72 + i] = nafasi_ya_kumaliza[i]; i = i + 1; }
    v[76] = waliomaliza;
    v[77] = chumba_kimesimamishwa;
    v[78] = SHERIA_NYUSO_ZA_CHINI;
    v[79] = aina_ya_mchezo;
    nakili(chombo_cha_hali + 320, majina_ya_viti, 64);
    nakili(chombo_cha_hali + 384, vitambulisho_vya_viti, 48);
}

// ---------------------------------------------------------------- akiba ya chumba
n8 chombo_cha_akiba[448];

// akiba mbili: "chumba" (mwenyeji wa Wi-Fi) na "mchezo" (kompyuta au simu
// moja). Huandikwa kila hali inapobadilika, kwa hiyo mfumo ukiifunga programu
// mchezo hauyeyuki: menyu huonyesha "Endelea" programu ikifunguliwa tena.
w0 hifadhi_hali(n8* faili) {
    kama (njia_ya(faili) == 0) { rudisha; }
    kama (mshindi >= 0) { wito_wa_mfumo(87, njia_ya_faili, 0, 0, 0, 0, 0); rudisha; }   // umekwisha: futa
    jaza_hali(0);
    n64 fd = wito_wa_mfumo(2, njia_ya_faili, 577, 384, 0, 0, 0);
    kama (fd < 0) { rudisha; }
    wito_wa_mfumo(1, fd, chombo_cha_hali, HALI_UREFU, 0, 0, 0);
    wito_wa_mfumo(3, fd, 0, 0, 0, 0, 0);
}

// 1 kama faili lina mchezo uliohifadhiwa ambao haujaisha (huusomwa kwenye chombo_cha_akiba)
n32 soma_akiba(n8* faili) {
    kama (njia_ya(faili) == 0) { rudisha 0; }
    n64 fd = wito_wa_mfumo(2, njia_ya_faili, 0, 0, 0, 0, 0);
    kama (fd < 0) { rudisha 0; }
    n64 n = wito_wa_mfumo(0, fd, chombo_cha_akiba, HALI_UREFU, 0, 0, 0);
    wito_wa_mfumo(3, fd, 0, 0, 0, 0, 0);
    n32* v = chombo_cha_akiba;
    rudisha n == HALI_UREFU && v[0] == 1346913107 && v[67] && v[56] < 0;
}

n32 mtandao_kuna_chumba_kilichohifadhiwa() { rudisha soma_akiba("chumba"); }
n32 kuna_mchezo_wa_simu_uliohifadhiwa() { rudisha soma_akiba("mchezo"); }
n32 aina_ya_mchezo_uliohifadhiwa() { n32* v = chombo_cha_akiba; rudisha v[79]; }

n8 nambari_ya_akiba[5];
n8* mtandao_nambari_ya_chumba_kilichohifadhiwa() {
    n32* v = chombo_cha_akiba;
    n32 i = 0;
    wakati (i < 4) { nambari_ya_akiba[i] = v[68 + i]; i = i + 1; }
    nambari_ya_akiba[4] = 0;
    rudisha nambari_ya_akiba;
}

w0 mtandao_tuma_hali() {
    kama (jukumu_la_mtandao != 1) {
        kama (aina_ya_mchezo != HALI_YA_MCHEZO_WIFI && skrini == S_MCHEZO) { hifadhi_hali("mchezo"); }
        rudisha;
    }
    n32 i = 0;
    wakati (i < 3) {
        kama (tundu_la_mteja[i] >= 0) {
            jaza_hali(i + 1);
            tuma_fremu(i, 1, 0, chombo_cha_hali, HALI_UREFU);
        }
        i = i + 1;
    }
    kama (skrini == S_MCHEZO) { hifadhi_hali("chumba"); }
}

// endeleza mchezo uliohifadhiwa: chumba kilekile (nambari ileile), viti vya
// wateja vikishikiliwa mpaka warudi
w0 soma_hali(n8* c);
w0 mtandao_endelea_chumba() {
    kama (mtandao_kuna_chumba_kilichohifadhiwa() == 0) { rudisha; }
    mtandao_anza_mwenyeji();
    kama (jukumu_la_mtandao != 1) { rudisha; }
    soma_hali(chombo_cha_akiba);
    n32* v = chombo_cha_akiba;
    n32 m = 0;
    wakati (m < 4) {
        nambari_ya_chumba[m] = v[68 + m];
        kama (mmiliki[m] >= 1) { mmiliki[m] = KITI_KINASUBIRI; }
        m = m + 1;
    }
    nambari_ya_chumba[4] = 0;
    aina_ya_mchezo = HALI_YA_MCHEZO_WIFI;
    akiba_halali = 0;
    uhuishaji = U_HAKUNA;
    toast_ujumbe = -1;
    nenda(S_MCHEZO);
    omba_fremu_ijayo();
}

// endeleza mchezo wa kompyuta au wa simu moja uliohifadhiwa
w0 endelea_mchezo_wa_simu() {
    kama (kuna_mchezo_wa_simu_uliohifadhiwa() == 0) { rudisha; }
    mtandao_funga();
    soma_hali(chombo_cha_akiba);
    aina_ya_mchezo = aina_ya_mchezo_uliohifadhiwa();
    akiba_halali = 0;
    uhuishaji = U_HAKUNA;
    hatua_iliyochaguliwa = 0;
    toast_ujumbe = -1;
    nenda(S_MCHEZO);
    omba_fremu_ijayo();
}

// mwenyeji: zamu ya aliyekatika ichezwe na kompyuta kuanzia sasa
w0 mtandao_kompyuta_ichukue_kiti(n32 m) {
    kama (jukumu_la_mtandao != 1 || mmiliki[m] != KITI_KINASUBIRI) { rudisha; }
    mmiliki[m] = -1;
    ni_kompyuta[m] = 1;
    weka_kitambulisho_cha_kiti(m, 0);
    mtandao_tuma_hali();
    omba_fremu_ijayo();
}

w0 mtandao_badili_kusimamisha() {
    kama (jukumu_la_mtandao != 1) { rudisha; }
    chumba_kimesimamishwa = 1 - chumba_kimesimamishwa;
    mtandao_tuma_hali();
    omba_fremu_ijayo();
}
n32 mtandao_kimesimamishwa() { rudisha (jukumu_la_mtandao == 1 || jukumu_la_mtandao == 2) && chumba_kimesimamishwa; }
n32 mtandao_kinaunganisha_upya() { rudisha kuunganisha_upya; }
w0 mtandao_acha_kuunganisha_upya() { kuunganisha_upya = 0; mtandao_funga(); }

w0 ondoa_mteja(n32 i) {
    tundu_funga(tundu_la_mteja[i]);
    tundu_la_mteja[i] = -1;
    kiasi_cha_mapokezi[i] = 0;
    kiasi_cha_foleni[i] = 0;
    omba_fremu_ijayo();
    n32 m = 0;
    wakati (m < 4) {
        kama (mmiliki[m] == i + 1) {
            // katikati ya mchezo kiti hushikiliwa mpaka arudi; kwenye lobby huachiwa
            kama (skrini == S_MCHEZO && mshindi < 0) { mmiliki[m] = KITI_KINASUBIRI; }
            sivyo { mmiliki[m] = -1; weka_kitambulisho_cha_kiti(m, 0); }
        }
        m = m + 1;
    }
    mtandao_tuma_hali();
}

w0 shughulikia_ombi(n32 mteja, n8* o, n32 urefu) {
    n32 aina = o[0] & 255;
    n32 a = o[1] & 255;
    n32 b = o[2] & 255;
    n8* kitambulisho_chake = 0;
    kama (urefu >= 32 && o[20] != 0) { kitambulisho_chake = o + 20; }
    kama (aina == 4 && (o[3] & 255) < TOLEO_LA_PROGRAMU) {
        // mteja ana toleo la zamani: mpe ofa ya toleo hili
        n32 ofa[2];
        ofa[0] = TOLEO_LA_PROGRAMU;
        ofa[1] = apk_ukubwa_wangu();
        kama (ofa[1] > 0) { tuma_fremu(mteja - 1, 4, 0, ofa, 8); }
    }
    kama (aina == 5) { upakiaji[mteja - 1] = 0; }
    kama (aina == 4) {
        // salamu: anayerudi hupewa viti vyake vilivyoshikiliwa; mgeni hupata
        // kiti cha kwanza kilicho wazi (kabla mchezo haujaanza tu)
        n32 amerudi = 0;
        n32 m = 0;
        wakati (m < 4) {
            kama (mmiliki[m] == KITI_KINASUBIRI && kitambulisho_cha_kiti_ni(m, kitambulisho_chake)) {
                mmiliki[m] = mteja;
                weka_jina_la_kiti(m, o + 4);
                amerudi = 1;
            }
            m = m + 1;
        }
        m = 0;
        wakati (m < 4 && mmiliki[m] != -1) { m = m + 1; }
        kama (amerudi == 0 && m < 4 && skrini != S_MCHEZO) {
            mmiliki[m] = mteja;
            weka_jina_la_kiti(m, o + 4);
            weka_kitambulisho_cha_kiti(m, kitambulisho_chake);
        }
    }
    kama (aina == 3 && a < 4 && mmiliki[a] == -1 && skrini != S_MCHEZO) {
        n32 m = 0;
        wakati (m < 4) { kama (mmiliki[m] == mteja) { mmiliki[m] = -1; weka_kitambulisho_cha_kiti(m, 0); } m = m + 1; }
        mmiliki[a] = mteja;
        weka_jina_la_kiti(a, o + 4);
        weka_kitambulisho_cha_kiti(a, kitambulisho_chake);
    }
    // hatua za mchezo hukubaliwa tu kutoka kwa mwenye zamu, uhuishaji ukiwa
    // umekwisha na chumba hakijasimamishwa
    kama ((aina == 1 || aina == 2) && skrini == S_MCHEZO && mmiliki[zamu] == mteja && uhuishaji == U_HAKUNA && chumba_kimesimamishwa == 0) {
        kama (aina == 1 && hali_ya_zamu == HALI_RUSHA) { fanya_rusha(); }
        kama (aina == 2 && hali_ya_zamu == HALI_SOGEZA) { fanya_hatua(a, b); }
    }
    mtandao_tuma_hali();
    omba_fremu_ijayo();
}

w0 mwenyeji_kila_fremu() {
    // wateja wapya
    n32 mpya = tundu_pokea_muunganiko(tundu_la_kusikiliza, 0, 0);
    kama (mpya >= 0) {
        n32 i = 0;
        wakati (i < 3 && tundu_la_mteja[i] >= 0) { i = i + 1; }
        kama (i < 3) { anza_muunganiko(i, mpya); mtandao_tuma_hali(); omba_fremu_ijayo(); }
        sivyo { tundu_funga(mpya); }
    }
    // maombi
    n32 i = 0;
    wakati (i < 3) {
        sukuma_foleni(i);
        kama (tundu_la_mteja[i] >= 0 && muunganiko_umevunjika[i]) { ondoa_mteja(i); }
        tuma_vipande_vya_apk(i);
        kama (tundu_la_mteja[i] >= 0) {
            n8* c = chombo_cha_mapokezi + i * MAPOKEZI;
            n64 n = tundu_pokea(tundu_la_mteja[i], c + kiasi_cha_mapokezi[i], MAPOKEZI - kiasi_cha_mapokezi[i], MSG_DONTWAIT);
            kama (n == 0) { ondoa_mteja(i); }
            kama (n > 0) {
                kiasi_cha_mapokezi[i] = kiasi_cha_mapokezi[i] + n;
                n32 urefu = fremu_kamili(c, kiasi_cha_mapokezi[i]);
                wakati (urefu > 0) {
                    n32 aina = c[0] & 255;
                    kama (aina == 2 && urefu >= 24) { shughulikia_ombi(i + 1, c + 4, urefu - 4); }
                    kama (aina == 3) {
                        // sauti ya mteja: cheza hapa, peleka kwa wateja wengine
                        n32 kiti = c[1] & 255;
                        sauti_pokea(kiti, c + 4, urefu - 4);
                        n32 x = 0;
                        wakati (x < 3) { kama (x != i) { tuma_fremu(x, 3, kiti, c + 4, urefu - 4); } x = x + 1; }
                    }
                    nakili(c, c + urefu, kiasi_cha_mapokezi[i] - urefu);
                    kiasi_cha_mapokezi[i] = kiasi_cha_mapokezi[i] - urefu;
                    urefu = fremu_kamili(c, kiasi_cha_mapokezi[i]);
                }
                kama (tundu_la_mteja[i] >= 0 && kiasi_cha_mapokezi[i] >= MAPOKEZI) { ondoa_mteja(i); }
            }
        }
        i = i + 1;
    }
    // tangazo kila sekunde, hata mchezoni: aliyekatika hukipata chumba tena
    n32 sasa = sasa_ms();
    kama (sasa - tangazo_la_mwisho > 1000) {
        tangazo_la_mwisho = sasa;
        n8 t[26];
        t[0] = 80; t[1] = 67; t[2] = 72; t[3] = 49;     // "PCH1"
        nakili(t + 4, nambari_ya_chumba, 4);
        nakili(t + 8, jina_la_mchezaji, 16);
        t[24] = (bandari_ya_chumba >> 8) & 255;
        t[25] = bandari_ya_chumba & 255;
        n8 a[16];
        soma_violesura();
        n32 v = 0;
        wakati (v < violesura_n) {
            anwani_ya_ipv4(a, violesura_matangazo[v], BANDARI_YA_TANGAZO);
            tundu_tuma_kwa(tundu_la_tangazo, t, 26, 0, a, 16);
            v = v + 1;
        }
        // hakuna kiolesura chenye matangazo kilichopatikana: matangazo ya jumla
        kama (violesura_n == 0) {
            anwani_ya_ipv4(a, -1, BANDARI_YA_TANGAZO);
            tundu_tuma_kwa(tundu_la_tangazo, t, 26, 0, a, 16);
        }
    }
}

// ---------------------------------------------------------------- mteja
w0 mtandao_anza_kutafuta() {
    mtandao_funga();
    tundu_la_tangazo = tundu_jipya(2, 2, 0);
    kama (tundu_la_tangazo < 0) { rudisha; }
    chaguo_moja(tundu_la_tangazo, 1, 2);           // SO_REUSEADDR
    chaguo_moja(tundu_la_tangazo, 1, 6);           // SO_BROADCAST
    n8 a[16];
    anwani_ya_ipv4(a, 0, BANDARI_YA_TANGAZO);
    tundu_funga_anwani(tundu_la_tangazo, a, 16);
    bila_kuzuia(tundu_la_tangazo);
    jukumu_la_mtandao = 3;
}

n32 linganisha_baiti(n8* a, n8* b, n32 n) {
    n32 i = 0;
    wakati (i < n) { kama (a[i] != b[i]) { rudisha 0; } i = i + 1; }
    rudisha 1;
}

w0 kutafuta_kila_fremu() {
    n8 t[64];
    n8 a[16];
    n32 urefu_a[1];
    urefu_a[0] = 16;
    n64 n = tundu_pokea_kutoka(tundu_la_tangazo, t, 64, MSG_DONTWAIT, a, urefu_a);
    wakati (n >= 24) {
        omba_fremu_ijayo();
        kama (t[0] == 80 && t[1] == 67 && t[2] == 72 && t[3] == 49) {
            // chumba kilichojulikana? sasisha muda; vinginevyo ongeza
            n32 i = 0;
            n32 kipo = -1;
            wakati (i < vyumba_n) {
                n32 sawa = 1;
                n32 b = 4;
                wakati (b < 8) { kama (vyumba_anwani[i * 16 + b] != a[b]) { sawa = 0; } b = b + 1; }
                kama (sawa) { kipo = i; }
                i = i + 1;
            }
            kama (kipo < 0 && vyumba_n < 5) { kipo = vyumba_n; vyumba_n = vyumba_n + 1; }
            kama (kipo >= 0) {
                // bandari ya mchezo iliyotangazwa (tangazo la zamani la baiti 24: ya kwanza)
                a[2] = (BANDARI_YA_MCHEZO >> 8) & 255;
                a[3] = BANDARI_YA_MCHEZO & 255;
                kama (n >= 26) { a[2] = t[24]; a[3] = t[25]; }
                nakili(vyumba_anwani + kipo * 16, a, 16);
                n8* j = vyumba_jina + kipo * 24;
                nakili(j, t + 4, 4);
                j[4] = 32;
                n32 x = 0;
                wakati (x < 16 && t[8 + x] != 0) { j[5 + x] = t[8 + x]; x = x + 1; }
                j[5 + x] = 0;
                vyumba_muda[kipo] = sasa_ms();
            }
        }
        urefu_a[0] = 16;
        n = tundu_pokea_kutoka(tundu_la_tangazo, t, 64, MSG_DONTWAIT, a, urefu_a);
    }
    // kuunganisha upya: chumba chenye nambari ileile kikionekana, jiunge
    kama (kuunganisha_upya) {
        n32 r = 0;
        wakati (r < vyumba_n) {
            kama (linganisha_baiti(vyumba_jina + r * 24, nambari_ya_chumba, 4)) { mtandao_jiunge(r); rudisha; }
            r = r + 1;
        }
    }
    // vyumba visivyotangaza kwa sekunde 4 huondolewa
    n32 i = 0;
    wakati (i < vyumba_n) {
        kama (sasa_ms() - vyumba_muda[i] > 4000) {
            n32 x = i;
            wakati (x + 1 < vyumba_n) {
                nakili(vyumba_anwani + x * 16, vyumba_anwani + (x + 1) * 16, 16);
                nakili(vyumba_jina + x * 24, vyumba_jina + (x + 1) * 24, 24);
                vyumba_muda[x] = vyumba_muda[x + 1];
                x = x + 1;
            }
            vyumba_n = vyumba_n - 1;
        } sivyo { i = i + 1; }
    }
}

w0 tuma_ombi(n32 aina, n32 a, n32 b) {
    kama (tundu_la_mteja[0] < 0) { rudisha; }
    n8 o[32];
    o[0] = aina; o[1] = a; o[2] = b; o[3] = TOLEO_LA_PROGRAMU;
    n32 i = 0;
    wakati (i < 16) { o[4 + i] = jina_la_mchezaji[i]; i = i + 1; }
    i = 0;
    wakati (i < 12) { o[20 + i] = kitambulisho[i]; i = i + 1; }
    tuma_fremu(0, 2, 0, o, 32);
}

// sauti ya simu hii: mteja humtumia mwenyeji; mwenyeji huwatumia wateja wote
w0 mtandao_tuma_sauti(n32 kiti, n8* data, n32 urefu) {
    kama (jukumu_la_mtandao == 2) { tuma_fremu(0, 3, kiti, data, urefu); }
    kama (jukumu_la_mtandao == 1) {
        n32 i = 0;
        wakati (i < 3) { tuma_fremu(i, 3, kiti, data, urefu); i = i + 1; }
    }
}

w0 mtandao_ombi(n32 aina, n32 a, n32 b) { tuma_ombi(aina, a, b); }

// kujiunga bila kuzuia: connect hurudi mara moja (EINPROGRESS), kisha kila tiki
// huangalia kwa poll kama muunganiko umekamilika; sekunde 4 bila jibu ni kosa
w0 mtandao_jiunge(n32 chumba) {
    kama (chumba >= vyumba_n || jukumu_la_mtandao == 4) { rudisha; }
    n8 a[16];
    nakili(a, vyumba_anwani + chumba * 16, 16);
    nakili(nambari_ya_chumba, vyumba_jina + chumba * 24, 4);
    nambari_ya_chumba[4] = 0;
    n32 t = tundu_jipya(2, 1, 0);
    kama (t < 0) { kosa_la_kuunganisha = sasa_ms(); rudisha; }
    anza_muunganiko(0, t);
    n32 jibu = tundu_unganisha(t, a, 16);
    tundu_funga(tundu_la_tangazo);
    tundu_la_tangazo = -1;
    kama (jibu == 0) { jukumu_la_mtandao = 2; tuma_ombi(4, 0, 0); omba_fremu_ijayo(); rudisha; }
    jukumu_la_mtandao = 4;
    kuunganisha_mwanzo = sasa_ms();
    omba_fremu_ijayo();
}

w0 kuunganisha_kumeshindwa() {
    tundu_funga(tundu_la_mteja[0]);
    tundu_la_mteja[0] = -1;
    kosa_la_kuunganisha = sasa_ms();
    n32 upya = kuunganisha_upya;
    mtandao_anza_kutafuta();
    kuunganisha_upya = upya;
    omba_fremu_ijayo();
}

w0 kuunganisha_kila_fremu() {
    n32 tukio[2];
    tukio[0] = tundu_la_mteja[0];
    tukio[1] = 4 | 8 | 16;                         // POLLOUT, POLLERR, POLLHUP
    subiri_matukio(tukio, 1, 0);
    n32 yaliyotokea = (tukio[1] >> 16) & 65535;
    kama (yaliyotokea != 0) {
        n32 kosa[1];
        n32 urefu[1];
        kosa[0] = -1;
        urefu[0] = 4;
        tundu_soma_chaguo(tundu_la_mteja[0], 1, 4, kosa, urefu);    // SOL_SOCKET, SO_ERROR
        kama (kosa[0] == 0 && (yaliyotokea & 24) == 0) {
            jukumu_la_mtandao = 2;
            tuma_ombi(4, 0, 0);
            omba_fremu_ijayo();
            rudisha;
        }
        kuunganisha_kumeshindwa();
        rudisha;
    }
    kama (sasa_ms() - kuunganisha_mwanzo > 4000) { kuunganisha_kumeshindwa(); }
}

n32 mtandao_inaunganisha() { rudisha jukumu_la_mtandao == 4; }
n32 mtandao_kosa_la_kujiunga() { rudisha kosa_la_kuunganisha != 0 && sasa_ms() - kosa_la_kuunganisha < 3000; }

// anwani ya IPv4 ya sockaddr_in kama maandishi "a.b.c.d"
n8 chombo_cha_anwani[20];
n8* anwani_kama_maandishi(n8* a) {
    n32 n = 0;
    n32 i = 4;
    wakati (i < 8) {
        n8* tarakimu = namba_kama_maandishi(a[i] & 255);
        n32 u = urefu_wa_mfuatano(tarakimu);
        nakili(chombo_cha_anwani + n, tarakimu, u);
        n = n + u;
        kama (i < 7) { chombo_cha_anwani[n] = 46; n = n + 1; }
        i = i + 1;
    }
    chombo_cha_anwani[n] = 0;
    rudisha chombo_cha_anwani;
}

n8* mtandao_anwani_ya_chumba(n32 i) { rudisha anwani_kama_maandishi(vyumba_anwani + i * 16); }

// anwani zote za simu hii kwenye mitandao ya karibu, mf. "192.168.43.1 · 192.168.1.10"
n8 anwani_zangu[96];
n8* mtandao_anwani_yangu() {
    soma_violesura();
    n32 n = 0;
    n32 v = 0;
    wakati (v < violesura_n && n < 70) {
        n8 a[16];
        anwani_ya_ipv4(a, violesura_ip[v], 0);
        n8* s = anwani_kama_maandishi(a);
        n32 u = urefu_wa_mfuatano(s);
        kama (v > 0) { anwani_zangu[n] = 32; anwani_zangu[n + 1] = 32; n = n + 2; }
        nakili(anwani_zangu + n, s, u);
        n = n + u;
        v = v + 1;
    }
    anwani_zangu[n] = 0;
    rudisha anwani_zangu;
}

w0 mtandao_dai_kiti(n32 m) {
    kama (jukumu_la_mtandao == 2) { tuma_ombi(3, m, 0); rudisha; }
    kama (jukumu_la_mtandao == 1 && mmiliki[m] == -1) {
        n32 x = 0;
        wakati (x < 4) { kama (mmiliki[x] == 0) { mmiliki[x] = -1; weka_kitambulisho_cha_kiti(x, 0); } x = x + 1; }
        mmiliki[m] = 0;
        weka_jina_la_kiti(m, jina_la_mchezaji);
        weka_kitambulisho_cha_kiti(m, kitambulisho);
        mtandao_tuma_hali();
    }
}

// tumia hali kutoka kwa mwenyeji, na huisha kilichobadilika
// hali yote ya mchezo kutoka kwenye chombo (kutoka kwa mwenyeji, au akiba)
w0 soma_hali(n8* c) {
    n32* v = c;
    n32 i = 0;
    wakati (i < 4) { kiti_kipo[i] = v[1 + i]; ni_kompyuta[i] = v[5 + i]; rangi_ya_kiti[i] = v[9 + i]; mmiliki[i] = v[13 + i]; i = i + 1; }
    i = 0;
    wakati (i < 16) { pauni[i] = v[17 + i]; i = i + 1; }
    zamu = v[33]; kete[0] = v[34]; kete[1] = v[35];
    i = 0;
    wakati (i < 8) { hatua[i] = v[36 + i]; hatua_ni_kete[i] = v[44 + i]; i = i + 1; }
    idadi_ya_hatua = v[52]; hali_ya_zamu = v[53]; ujumbe = v[54]; ujumbe_wa_mchezaji = v[55];
    mshindi = v[56]; pacha_mfululizo = v[57]; ilikuwa_pacha = v[58];
    SHERIA_KUINGIA = v[59]; SHERIA_ZAWADI_YA_KULA = v[60]; SHERIA_ZAWADI_YA_NYUMBANI = v[61];
    SHERIA_VIZUIZI = v[62]; SHERIA_SALAMA = v[63]; SHERIA_PACHA_TATU = v[64]; PAUNI_KWA_MCHEZAJI = v[65];
    nafasi_ya_mteja = v[66];
    i = 0;
    wakati (i < 4) { nafasi_ya_kumaliza[i] = v[72 + i]; i = i + 1; }
    waliomaliza = v[76];
    chumba_kimesimamishwa = v[77];
    SHERIA_NYUSO_ZA_CHINI = v[78];
    nakili(majina_ya_viti, c + 320, 64);
    nakili(vitambulisho_vya_viti, c + 384, 48);
}

w0 pokea_hali(n8* c) {
    n32* v = c;
    kama (v[0] != 1346913107) { rudisha; }
    n32 zamu_ya_zamani = zamu;
    n32 hali_ya_zamani = hali_ya_zamu;
    n32 kete_za_zamani = kete[0] * 8 + kete[1];
    n32 ilikuwa_mchezoni = skrini == S_MCHEZO;
    n32 i = 0;
    wakati (i < 16) { pauni_kabla[i] = pauni[i]; i = i + 1; }
    soma_hali(c);
    kuunganisha_upya = 0;
    kama (v[67] && ilikuwa_mchezoni == 0) {
        akiba_halali = 0;
        uhuishaji = U_HAKUNA;
        toast_ujumbe = -1;
        aina_ya_mchezo = HALI_YA_MCHEZO_WIFI;
        nenda(S_MCHEZO);
        rudisha;
    }
    kama (v[67] == 0 || ilikuwa_mchezoni == 0) { rudisha; }
    // pauni zimebadilika: hatua ya mchezaji aliyekuwa na zamu
    n32 imebadilika = 0;
    i = 0;
    wakati (i < 16) { kama (pauni[i] != pauni_kabla[i]) { imebadilika = 1; } i = i + 1; }
    kama (imebadilika) {
        anza_uhuishaji_wa_hatua(zamu_ya_zamani);
        kama (mshindi >= 0) { mwisho_wa_mchezo(); }
    } sivyo {
        kama (hali_ya_zamani == HALI_RUSHA && (kete[0] * 8 + kete[1] != kete_za_zamani || hali_ya_zamu != HALI_RUSHA || zamu != zamu_ya_zamani)) {
            uhuishaji = U_KETE;
            uhuishaji_mwanzo = sasa_ms();
        }
    }
}

w0 mteja_kila_fremu() {
    kama (tundu_la_mteja[0] < 0) { rudisha; }
    sukuma_foleni(0);
    n8* c = chombo_cha_mapokezi;
    n64 n = tundu_pokea(tundu_la_mteja[0], c + kiasi_cha_mapokezi[0], MAPOKEZI - kiasi_cha_mapokezi[0], MSG_DONTWAIT);
    kama (n == 0 || muunganiko_umevunjika[0]) {
        // mwenyeji amekatika: katikati ya mchezo, tafuta chumba kilekile na
        // urudi kiti chako (kitambulisho); vinginevyo rudi menyu
        kama (skrini == S_MCHEZO && mshindi < 0) {
            mtandao_anza_kutafuta();
            kuunganisha_upya = 1;
            omba_fremu_ijayo();
            rudisha;
        }
        mtandao_funga();
        nenda(S_MENYU);
        rudisha;
    }
    kama (n > 0) { kiasi_cha_mapokezi[0] = kiasi_cha_mapokezi[0] + n; }
    n32 urefu = fremu_kamili(c, kiasi_cha_mapokezi[0]);
    wakati (urefu > 0) {
        n32 aina = c[0] & 255;
        kama (aina == 1 && urefu >= 4 + HALI_UREFU) { pokea_hali(c + 4); omba_fremu_ijayo(); }
        kama (aina == 3) { sauti_pokea(c[1] & 255, c + 4, urefu - 4); }
        kama (aina == 4 && urefu >= 12) { n32* ofa = c + 4; sasisho_ofa(ofa[0], ofa[1]); }
        kama (aina == 5) { sasisho_kipande(c + 4, urefu - 4); }
        nakili(c, c + urefu, kiasi_cha_mapokezi[0] - urefu);
        kiasi_cha_mapokezi[0] = kiasi_cha_mapokezi[0] - urefu;
        urefu = fremu_kamili(c, kiasi_cha_mapokezi[0]);
    }
}

// huitwa kila fremu wakati mtandao uko hai
w0 mtandao_kila_fremu() {
    // tiki tu; kuchora huombwa data inapofika
    kama (jukumu_la_mtandao == 1) { mwenyeji_kila_fremu(); omba_tiki(); }
    kama (jukumu_la_mtandao == 2) { mteja_kila_fremu(); omba_tiki(); }
    kama (jukumu_la_mtandao == 3) { kutafuta_kila_fremu(); omba_tiki(); }
    kama (jukumu_la_mtandao == 4) { kuunganisha_kila_fremu(); omba_tiki(); }
}

w0 andaa_mtandao() {
    n32 i = 0;
    wakati (i < 3) { tundu_la_mteja[i] = -1; i = i + 1; }
    i = 0;
    wakati (i < 4) { mmiliki[i] = -1; i = i + 1; }
}
